# Optional: Notion Token is used to fetch documents from Notion by Claude Code custom mcp
NOTION_TOKEN=
# Optional: Notion Token is used to add documents to Notion by Claude Code custom mcp
NOTION_TOKEN_DOC=

# Frontend (public: embedded in the bundle, never put secrets here)
# Base URL of apps/api
VITE_API_URL=http://localhost:8000
# true = serve typed fixtures from src/api/mocks instead of calling the API
VITE_USE_MOCKS=true
